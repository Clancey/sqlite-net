<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <PackageId>SQLite-NET.MariaDB</PackageId>
    <PackageVersion>1.11.0</PackageVersion>
    <Authors>Frank Krueger</Authors>
    <Owners>Frank Krueger</Owners>
    <Summary>MariaDB provider for SQLite-NET ORM</Summary>
    <Description>MariaDB database provider for SQLite-NET. Allows using the familiar SQLite-NET API with MariaDB databases. Install this package alongside SQLite-NET.SQLite to enable MariaDB support.</Description>
    <PackageReleaseNotes>MariaDB provider for SQLite-NET multi-database architecture</PackageReleaseNotes>
    <PackageTags>mariadb mysql database sql orm provider netstandard</PackageTags>
    <PackageProjectUrl>https://github.com/praeclarum/sqlite-net</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Logo-low.png</PackageIcon>
    <RepositoryUrl>https://github.com/praeclarum/sqlite-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.2.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SQLite-NET.Core/SQLite-NET.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../Logo-low.png">
      <Pack>True</Pack>
      <PackagePath>.</PackagePath>
    </None>
  </ItemGroup>

</Project>